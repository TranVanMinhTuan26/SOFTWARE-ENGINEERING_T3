DB_PORT=5433
DATABASE_URL=postgresql://brewlite:brewlite_dev_password@localhost:5433/brewlite?schema=public
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
STAFF_KEY=local-staff-key-change-me
ADMIN_EMAIL=admin@brewlite.local
ADMIN_PASSWORD=Admin123!
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:4000/payments/vnpay/return
ALLOW_INSECURE_PASSWORD_RESET=false
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_PASSWORD_RESET=false

# Set development only for an explicitly enabled local OTP demo.
API_NODE_ENV=production

# Test configuration: copy this commented block into .env.test when needed.
# DATABASE_URL=postgresql://brewlite_test:test_only_password@localhost:55432/brewlite_test?schema=public
# JWT_SECRET=dedicated-test-only-secret-do-not-use-in-production
# VNPAY_TMN_CODE=TESTONLY
# VNPAY_HASH_SECRET=dedicated-test-signing-key-do-not-use-in-production
# VNPAY_RETURN_URL=http://localhost:4000/payments/vnpay/return
# WEB_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# TEST_API_URL=http://localhost:4000
# TEST_WEB_URL=http://localhost:3000

# Production: use .env on the VPS and replace the local settings below.
# Keep NODE_ENV=production / API_NODE_ENV=production and demo reset disabled.
# IMAGE_OWNER=your-lowercase-github-owner
# IMAGE_TAG=replace-with-commit-sha
# POSTGRES_USER=brewlite
# POSTGRES_PASSWORD=replace-with-random-url-safe-password
# POSTGRES_DB=brewlite
# DATABASE_URL=postgresql://brewlite:replace-with-random-url-safe-password@db:5432/brewlite?schema=public
# JWT_SECRET=replace-with-long-random-secret
# WEB_DOMAIN=coffee.example.com
# API_DOMAIN=api-coffee.example.com
# VNPAY_TMN_CODE=replace-with-merchant-code
# VNPAY_HASH_SECRET=replace-with-merchant-secret
