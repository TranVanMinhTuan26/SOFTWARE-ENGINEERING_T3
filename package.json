{
  "name": "brewlite-assignment-1",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:generate": "npm run db:generate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "prisma:generate": "npm run db:generate -w apps/api",
    "prisma:migrate:deploy": "npm run db:deploy -w apps/api",
    "test": "npm test -w apps/api",
    "test:api": "npm test -w apps/api",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:all": "npm test -w apps/api && node --test tests/integration/*.test.js tests/e2e/*.test.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
