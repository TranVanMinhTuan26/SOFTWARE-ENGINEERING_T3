{
  "name": "brewlite-assignment-2",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run start:dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "prisma:generate": "npm run db:generate -w backend",
    "prisma:migrate:deploy": "npm run db:deploy -w backend",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "lint": "eslint backend frontend tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "test": "npm test -w backend && node --test tests/deploy.test.cjs",
    "test:integration": "node --test tests/integration/*.test.cjs",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run build && npm run test:integration && npm run test:e2e",
    "smoke": "node scripts/smoke.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.72.2"
  },
  "version": "2.0.0"
}
