# Local workstation settings. This file is safe to commit; never put real production secrets here.
DATABASE_URL=postgresql://brewlite:brewlite_dev_password@localhost:5432/brewlite?schema=public
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
STAFF_KEY=local-staff-key-change-me

ADMIN_EMAIL=admin@brewlite.local
ADMIN_PASSWORD=Admin123!

# VNPay Sandbox credentials (Configured via Sandbox Dashboard: https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_RETURN_URL=http://localhost:4000/payments/vnpay/return

ALLOW_INSECURE_PASSWORD_RESET=false
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_PASSWORD_RESET=false
