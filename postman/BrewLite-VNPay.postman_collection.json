{
  "info": {
    "name": "BrewLite - VNPay",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "VNPay-only local API checks. No mock payments or signed success callbacks. Request 08 either returns a VNPay redirect URL or explicitly verifies missing merchant configuration; a redirect is not a completed payment."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Functional",
      "item": [
        {
          "name": "01 Menu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Menu loads\", () => pm.response.to.have.status(200));",
                  "const product = pm.response.json().find(p => p.available);",
                  "pm.test(\"Available product exists\", () => pm.expect(product).to.be.an(\"object\"));",
                  "if (product) pm.collectionVariables.set(\"productId\", product.id);",
                  "pm.collectionVariables.set(\"email\", \"postman-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Product detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"TestPass123!\",\n  \"fullName\": \"Postman VNPay Customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Registered\", () => pm.response.to.have.status(201));",
                  "pm.test(\"No password hash\", () => pm.expect(pm.response.text()).not.to.include(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"TestPass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Logged in\", () => pm.response.to.have.status(201));",
                  "const loginResponse = pm.response.json();",
                  "pm.test(\"JWT returned\", () => pm.expect(loginResponse.accessToken).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"token\", loginResponse.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Add cart item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/cart/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"size\": \"M\",\n  \"toppings\": [],\n  \"qty\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cart item added\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Cart total",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/cart"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cart loads\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cart contains one item\", () => pm.expect(pm.response.json().items).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Create VNPay order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"size\": \"M\",\n      \"toppings\": [],\n      \"qty\": 1\n    }\n  ],\n  \"paymentMethod\": \"VNPay\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order created\", () => pm.response.to.have.status(201));",
                  "const order = pm.response.json();",
                  "pm.test(\"Order pending\", () => pm.expect(order.status).to.eql(\"PENDING\"));",
                  "pm.collectionVariables.set(\"orderId\", order.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 VNPay redirect URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payments/vnpay/create",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.test(\"Signed VNPay URL returned\", () => pm.expect(pm.response.json().paymentUrl).to.match(/^https:\\/\\/sandbox\\.vnpayment\\.vn\\//));",
                  "  pm.collectionVariables.set(\"paymentUrl\", pm.response.json().paymentUrl);",
                  "} else {",
                  "  pm.test(\"Unconfigured VNPay is rejected explicitly\", () => { pm.response.to.have.status(400); pm.expect(pm.response.json().message).to.include(\"VNPay\"); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Confirm pending order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Order loads\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Same pending order\", () => { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"orderId\")); pm.expect(pm.response.json().status).to.eql(\"PENDING\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "NonFunctional",
      "item": [
        {
          "name": "Health and database",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Public promotions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/promotions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Promotions are reachable\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing JWT is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing JWT rejected\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid JWT is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer forged"
              }
            ],
            "url": "{{baseUrl}}/orders/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid JWT rejected\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registration validation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bad\",\n  \"password\": \"1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bad input rejected\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid callback signature",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/vnpay/ipn?vnp_SecureHash=bad"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid signature rejected\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().RspCode).to.eql(\"97\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
